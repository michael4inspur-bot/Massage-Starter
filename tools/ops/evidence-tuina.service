# EvidenceTuina（ms.port.et）systemd 单元模板。tools/ops/bootstrap-server.sh 会把 __NODE_BIN__ / __MS_ROOT__ 换成实际值后
# 装到 /etc/systemd/system/evidence-tuina.service。应用监听 127.0.0.1:9600，只由 nginx 反代，不开防火墙端口。
[Unit]
Description=EvidenceTuina 循证推拿实验室 (Next.js, 127.0.0.1:9600)
After=network.target

[Service]
Type=simple
User=ghrunner
Group=msdeploy
WorkingDirectory=__MS_ROOT__/current
EnvironmentFile=__MS_ROOT__/.env.production
# 没有发布过产物时不要反复起停
ExecStartPre=/usr/bin/test -f __MS_ROOT__/current/server.js
ExecStart=__NODE_BIN__ server.js
Restart=always
RestartSec=3
# 联调机内存紧张：堆上限 512 MB，到顶抛可读的 OOM 而不是拖死整机
Environment=NODE_OPTIONS=--max-old-space-size=512
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
